pipeline {
    agent any

    environment {
        PROJECT_HOME = "${WORKSPACE}/welcome/app/flask-volt-dashboard"
    }

    stages {
        stage('Clone Project') {
            steps {
                git branch: 'jenkins-workshop', url: 'https://github.com/yanivomc/devopshift-welcome.git'
            }
        }

        stage('Build and Deploy Container') {
            steps {
                dir("${PROJECT_HOME}") {
                    sh 'docker compose down'
                    sh 'docker compose up -d --build'
                }
            }
        }

        stage('Verify Application') {
            steps {
                script {
                    sleep 5
                    def statusCode = sh(script: "curl -s -o /dev/null -w '%{http_code}' http://localhost:5005", returnStdout: true).trim()
                    if (statusCode != "200") {
                        dir("${PROJECT_HOME}") {
                            sh 'docker compose logs'
                        }
                        error "Flask application container failed to respond (HTTP status: ${statusCode})"
                    } else {
                        echo "Flask application container is up and running successfully!"
                    }
                }
            }
        }

        stage('Wait for User Approval') {
            steps {
                script {
                    def userInput = input message: 'Is the containerized application running successfully?',
                                          parameters: [choice(name: 'Continue', choices: 'Continue\nCancel', description: 'Choose an option')]
                    env.USER_CHOICE = userInput
                }
            }
        }

        stage('Finalize') {
            steps {
                script {
                    if (env.USER_CHOICE == 'Continue') {
                        echo 'Pipeline completed successfully.'
                    } else {
                        dir("${PROJECT_HOME}") {
                            sh 'docker compose down'
                        }
                        error 'Pipeline cancelled by user.'
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '**/container_output.log', allowEmptyArchive: true
        }
        failure {
            dir("${PROJECT_HOME}") {
                sh 'docker compose down'
       		     }
       		 }
   	 }	
    }
}
